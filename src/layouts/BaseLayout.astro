---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import FloatingCall from '../components/layout/FloatingCall.astro';
import CallSheet from '../components/layout/CallSheet.astro';
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  currentPath?: string;
}

const {
  title = `${site.name} — Premier Electrical & Lighting Showroom Addis Ababa`,
  description = 'High-end architectural lighting, LED strip lights, commercial street luminaires, and luxury electrical accessories in Addis Ababa, Ethiopia.',
  ogImage = '/og-image.jpg',
  ogType = 'website',
  canonicalUrl = Astro.url.href,
  currentPath = Astro.url.pathname,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : 'https://luxurylighting.vercel.app';
const fullOgImageUrl = new URL(ogImage, siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ElectricalStore",
  "name": site.name,
  "alternateName": site.name,
  "description": description,
  "url": siteUrl,
  "logo": new URL('/favicon.svg', siteUrl).toString(),
  "image": fullOgImageUrl,
  "telephone": site.phones.map(p => `+251${p.number.replace(/\D/g, '').slice(1)}`),
  "address": {
    "@type": "PostalAddress",
    "streetAddress": site.address.line,
    "addressLocality": site.address.city,
    "addressCountry": "ET"
  },
  "sameAs": [
    site.telegram.channel,
    site.telegram.inbox,
    site.tiktok
  ],
  "openingHours": "Mo-Sa 08:30-18:30",
  "priceRange": "$$"
};
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#5BE584" />
    <meta name="color-scheme" content="dark" />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Instant Pre-Hydration Modal & Mobile Drawer Controller -->
    <script is:inline>
      (function() {
        var modalOpenTime = 0;
        var menuOpenTime = 0;

        window.__openCallModal = function(productName) {
          modalOpenTime = Date.now();
          var modal = document.getElementById('call-sheet-modal');
          if (!modal) {
            document.addEventListener('DOMContentLoaded', function() {
              window.__openCallModal(productName);
            }, { once: true });
            return;
          }
          var title = document.getElementById('call-sheet-title');
          var subtitle = document.getElementById('call-sheet-subtitle');
          if (productName && typeof productName === 'string' && productName.trim().length > 0) {
            if (title) title.textContent = 'Request Price & Order';
            if (subtitle) subtitle.textContent = 'Inquiring for: ' + productName;
          } else {
            if (title) title.textContent = 'Choose a Showroom Line to Call';
            if (subtitle) subtitle.textContent = 'Connect directly with our team at Sosa Merkato Building';
          }
          modal.classList.add('is-open');
          modal.style.display = 'block';
          modal.setAttribute('aria-hidden', 'false');
          document.body.classList.add('modal-open');
          document.body.style.overflow = 'hidden';
          var content = document.getElementById('call-sheet-content');
          if (content) {
            content.style.transform = 'translateY(0)';
          }
        };

        window.__closeCallModal = function() {
          var modal = document.getElementById('call-sheet-modal');
          if (!modal) return;
          modal.classList.remove('is-open');
          modal.setAttribute('aria-hidden', 'true');
          var content = document.getElementById('call-sheet-content');
          if (content) {
            content.style.transform = 'translateY(100%)';
          }
          setTimeout(function() {
            if (!modal.classList.contains('is-open')) {
              modal.style.display = 'none';
            }
          }, 250);
          document.body.classList.remove('modal-open');
          document.body.style.overflow = '';
        };

        window.__openMobileMenu = function() {
          menuOpenTime = Date.now();
          var drawer = document.getElementById('mobile-drawer');
          var backdrop = document.getElementById('menu-backdrop');
          if (!drawer || !backdrop) {
            document.addEventListener('DOMContentLoaded', function() {
              window.__openMobileMenu();
            }, { once: true });
            return;
          }
          drawer.classList.add('is-open');
          drawer.style.display = 'flex';
          drawer.style.transform = 'translateX(0)';
          drawer.setAttribute('aria-hidden', 'false');

          backdrop.classList.add('is-open');
          backdrop.style.display = 'block';
          backdrop.style.opacity = '1';

          document.body.classList.add('menu-open');
          document.body.style.overflow = 'hidden';

          var closeBtn = document.getElementById('menu-close-btn');
          if (closeBtn) closeBtn.focus();
        };

        window.__closeMobileMenu = function() {
          var drawer = document.getElementById('mobile-drawer');
          var backdrop = document.getElementById('menu-backdrop');
          if (drawer) {
            drawer.classList.remove('is-open');
            drawer.style.transform = 'translateX(100%)';
            drawer.setAttribute('aria-hidden', 'true');
            setTimeout(function() {
              if (!drawer.classList.contains('is-open')) {
                drawer.style.display = 'none';
              }
            }, 300);
          }
          if (backdrop) {
            backdrop.classList.remove('is-open');
            backdrop.style.opacity = '0';
            setTimeout(function() {
              if (!backdrop.classList.contains('is-open')) {
                backdrop.style.display = 'none';
              }
            }, 300);
          }
          document.body.classList.remove('menu-open');
          document.body.style.overflow = '';
          var openBtn = document.getElementById('menu-open-btn');
          if (openBtn) openBtn.focus();
        };

        window.__canCloseModalBackdrop = function() {
          return (Date.now() - modalOpenTime) > 400;
        };
        window.__canCloseMenuBackdrop = function() {
          return (Date.now() - menuOpenTime) > 400;
        };
      })();
    </script>
  </head>
  <body class="bg-[#050807] text-[#C1C8C4] antialiased min-h-screen flex flex-col selection:bg-[#5BE584] selection:text-[#050807]">
    <!-- Accessibility Skip Link -->
    <a href="#main-content" class="skip-to-content">
      Skip to main content
    </a>

    <!-- Header -->
    <Header currentPath={currentPath} />

    <!-- Main Content -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Mobile Drawer & Overlays -->
    <MobileMenu />
    <FloatingCall />
    <CallSheet />

    <!-- Bilingual English/Amharic Controller -->
    <script src="../scripts/i18n.ts"></script>
  </body>
</html>
