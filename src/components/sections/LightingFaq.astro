---
// Customer FAQs

const faqs = [
  {
    q: 'Where is your showroom located in Addis Ababa?',
    a: 'We are located in Merkato, inside the Merkato Sosa Building, conveniently situated between Harere Hotel and Derba Lime and Chemicals. You can inspect working fixtures on our live showroom display wall.',
  },
  {
    q: 'Do you offer contractor and wholesale volume discounts?',
    a: 'Yes, absolutely. We work closely with electrical contractors, interior designers, real estate developers, and retail stores, offering structured wholesale volume pricing. Call our wholesale line at 0910404241 or message us on Telegram.',
  },
  {
    q: 'How fast is delivery within Addis Ababa?',
    a: 'We provide prompt same-day dispatch across Addis Ababa for confirmed orders. Alternatively, your order can be packaged and ready for immediate in-person pickup at our Merkato Sosa showroom.',
  },
  {
    q: 'How do I request prices and verify available stock?',
    a: 'You can tap any "Request Price" button on this website, call our direct phone numbers (0911948627, 0935021157, 0910404241, 0910210089), or send your inquiry or Bill of Quantities directly to Telegram (@Rezured).',
  },
];
---

<section class="py-12 sm:py-16 bg-white border-t border-gray-200/60" id="lighting-faq-section">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-8 sm:mb-12">
      <span class="text-xs font-bold text-[#28e374] uppercase tracking-wider block mb-1">
        QUESTIONS & ANSWERS
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0f172a] tracking-tight">
        Frequently Asked Questions
      </h2>
      <p class="text-xs sm:text-sm text-gray-500 max-w-xl mx-auto mt-1.5 leading-relaxed">
        Common questions about our Merkato showroom, custom quotes, delivery, and wholesale volume pricing.
      </p>
    </div>

    <!-- FAQs Accordion -->
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="group bg-[#f8faf9] rounded-2xl border border-gray-200/90 overflow-hidden transition-all [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between p-4 sm:p-5 font-bold text-sm sm:text-base text-[#0f172a] cursor-pointer select-none group-open:text-emerald-700 transition-colors">
            <span class="pr-4">{faq.q}</span>
            <div class="w-7 h-7 rounded-full bg-white border border-gray-200 flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform">
              <svg class="text-[#28e374]" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </summary>
          <div class="px-4 pb-4 sm:px-5 sm:pb-5 text-xs sm:text-sm text-gray-600 leading-relaxed pt-1 border-t border-gray-100">
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
