---
import { Image } from 'astro:assets';
import site from '../../data/site.json';

// Import featured product images
import pendantImg from '../../assets/products/led-panel-lights/architectural-linear-pendant.png';
import stripImg from '../../assets/products/led-strip-lights/commercial-led-strip-reel.jpg';
import floodlightImg from '../../assets/products/led-street-lights/kk-electric-100w-floodlight.jpg';
import switchImg from '../../assets/products/electrical-accessories/star-silver-modular-switches.jpg';
import spotlightImg from '../../assets/products/led-panel-lights/kk-deep-spot-black.jpg';
import street150Img from '../../assets/products/led-street-lights/street-light-150w.jpg';

interface FeaturedItem {
  id: string;
  name: string;
  category: string;
  categorySlug: string;
  image: ImageMetadata;
  badge: string;
  specs: {
    power: string;
    rating: string;
    optical: string;
  };
}

const featuredProducts: FeaturedItem[] = [
  {
    id: 'architectural-linear-pendant',
    name: 'Architectural Suspended Linear Luminaire',
    category: 'LED Panel & Linear',
    categorySlug: 'led-panel-lights',
    image: pendantImg,
    badge: 'Showroom Pick',
    specs: {
      power: 'Ceiling Suspension Kit',
      rating: 'IP20 Architectural',
      optical: 'Matte Black / Anti-Glare',
    },
  },
  {
    id: 'commercial-led-strip-reel',
    name: 'Commercial High-Density 220V LED Strip (100m)',
    category: 'LED Strip Lights',
    categorySlug: 'led-strip-lights',
    image: stripImg,
    badge: 'Best Seller',
    specs: {
      power: '220V Direct Input Spool',
      rating: 'IP65 Weatherproof',
      optical: 'High Diode Lumen / Cove',
    },
  },
  {
    id: 'kk-electric-100w-floodlight',
    name: 'KK Electric 100W Heavy-Duty Outdoor Floodlight',
    category: 'LED Street & Outdoor',
    categorySlug: 'led-street-lights',
    image: floodlightImg,
    badge: 'Heavy-Duty',
    specs: {
      power: '100W High Lumen Array',
      rating: 'IP66 Waterproof',
      optical: 'Die-Cast Aluminum Body',
    },
  },
  {
    id: 'star-silver-modular-switches',
    name: 'STAR Silver Luxury Modular Switches & Sockets',
    category: 'Electrical Accessories',
    categorySlug: 'electrical-accessories',
    image: switchImg,
    badge: 'Luxury Series',
    specs: {
      power: '16A Heavy-Duty Terminal',
      rating: 'Flame-Retardant PC',
      optical: 'Metallic Silver Finish',
    },
  },
  {
    id: 'kk-deep-spot-black',
    name: 'KK Anti-Glare Deep-Set Recessed Spotlight',
    category: 'LED Panel & Spots',
    categorySlug: 'led-panel-lights',
    image: spotlightImg,
    badge: 'Popular',
    specs: {
      power: 'Precision LED Driver',
      rating: 'Deep-Recessed Lens',
      optical: 'Warm / Neutral White',
    },
  },
  {
    id: 'street-light-150w',
    name: '150W Commercial Roadway LED Luminaire',
    category: 'LED Street Lights',
    categorySlug: 'led-street-lights',
    image: street150Img,
    badge: 'Commercial',
    specs: {
      power: '150W Multi-Module',
      rating: 'IP65 Weather-Sealed',
      optical: 'Pole Mount Collar',
    },
  },
];
---

<section class="py-12 sm:py-16 bg-white border-t border-b border-gray-200/70" id="featured-products-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 sm:mb-10">
      <div>
        <span class="text-xs font-bold text-[#28e374] uppercase tracking-wider block mb-1">
          CURATED SHOWROOM INVENTORY
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0f172a] tracking-tight">
          Featured Products & Specifications
        </h2>
        <p class="text-xs sm:text-sm text-gray-500 max-w-xl mt-1.5 leading-relaxed">
          High-performance architectural luminaires and electrical gear in stock at Merkato Sosa Building. Request instant pricing via call or Telegram.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/products"
          class="inline-flex items-center gap-1.5 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full bg-[#f4f7f6] hover:bg-gray-100 border border-gray-300 text-xs sm:text-sm font-bold text-gray-900 transition-all active:scale-95 shrink-0"
        >
          <span>All 30+ Products</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {featuredProducts.map((product) => (
        <div class="group bg-[#f8faf9] rounded-2xl border border-gray-200/90 p-4 sm:p-5 flex flex-col justify-between hover:shadow-xl hover:border-emerald-300 transition-all duration-300">
          <div>
            <!-- Image Container -->
            <div class="aspect-[4/3] rounded-xl bg-white border border-gray-100 p-3 sm:p-4 flex items-center justify-center overflow-hidden relative mb-4">
              <span class="absolute top-2.5 left-2.5 z-10 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 text-[10px] font-bold border border-emerald-200 shadow-2xs">
                {product.badge}
              </span>

              <Image
                src={product.image}
                alt={product.name}
                width={360}
                height={270}
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
              />
            </div>

            <!-- Category & Title -->
            <span class="text-[11px] font-semibold text-emerald-700 uppercase tracking-wider block mb-1">
              {product.category}
            </span>
            <h3 class="text-sm sm:text-base font-bold text-[#0f172a] group-hover:text-emerald-700 transition-colors line-clamp-2 leading-snug mb-3">
              {product.name}
            </h3>

            <!-- Specifications List -->
            <div class="space-y-1.5 pt-3 border-t border-gray-200/80 mb-5">
              <div class="flex items-center justify-between text-xs py-0.5">
                <span class="text-gray-500 font-medium">Power / Profile:</span>
                <span class="font-semibold text-gray-800 text-right">{product.specs.power}</span>
              </div>
              <div class="flex items-center justify-between text-xs py-0.5">
                <span class="text-gray-500 font-medium">Protection:</span>
                <span class="font-semibold text-gray-800 text-right">{product.specs.rating}</span>
              </div>
              <div class="flex items-center justify-between text-xs py-0.5">
                <span class="text-gray-500 font-medium">Optics / Finish:</span>
                <span class="font-semibold text-gray-800 text-right">{product.specs.optical}</span>
              </div>
            </div>
          </div>

          <!-- Price Request & Action Buttons -->
          <div class="pt-3 border-t border-gray-200/80 flex items-center gap-2">
            <button
              type="button"
              class="trigger-call-modal flex-1 bg-[#28e374] hover:bg-[#2fd468] text-[#050807] font-bold text-xs sm:text-sm py-2.5 px-3 rounded-xl flex items-center justify-center gap-1.5 shadow-xs cursor-pointer active:scale-95 transition-all"
              data-product-name={product.name}
              aria-label={`Request price for ${product.name}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>Request Price</span>
            </button>

            <!-- Telegram Quick Link -->
            <a
              href={`${site.telegram.inbox}?text=Hello,%20I%20am%20inquiring%20about%20the%20price%20of:%20${encodeURIComponent(product.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-xl bg-white hover:bg-[#2aabee] text-gray-700 hover:text-white border border-gray-200/80 flex items-center justify-center transition-colors shrink-0 shadow-2xs"
              aria-label={`Inquire about ${product.name} on Telegram`}
              title="Inquire on Telegram"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
