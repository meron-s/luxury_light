---
import { Image } from 'astro:assets';
import categories from '../../data/categories.json';

// Import category images
import stripImg from '../../assets/categories/led-strip-lights.jpg';
import panelImg from '../../assets/categories/led-panel-lights.jpg';
import streetImg from '../../assets/categories/led-street-lights.jpg';
import accessoriesImg from '../../assets/categories/electrical-accessories.jpg';
import cablesImg from '../../assets/categories/cables-and-wires.jpg';
import fansImg from '../../assets/categories/fans-and-ventilation.jpg';

const categoryImages: Record<string, any> = {
  'led-strip-lights': stripImg,
  'led-panel-lights': panelImg,
  'led-street-lights': streetImg,
  'electrical-accessories': accessoriesImg,
  'cables-and-wires': cablesImg,
  'fans-and-ventilation': fansImg,
};

const i18nKeys: Record<string, { title: string; tag: string }> = {
  'led-strip-lights': { title: 'categories.strip_title', tag: 'categories.strip_tag' },
  'led-panel-lights': { title: 'categories.panel_title', tag: 'categories.panel_tag' },
  'led-street-lights': { title: 'categories.street_title', tag: 'categories.street_tag' },
  'electrical-accessories': { title: 'categories.accessories_title', tag: 'categories.accessories_tag' },
  'cables-and-wires': { title: 'categories.cables_title', tag: 'categories.cables_tag' },
  'fans-and-ventilation': { title: 'categories.fans_title', tag: 'categories.fans_tag' },
};

const categoryHighlights: Record<string, string[]> = {
  'led-strip-lights': ['COB & 2835 SMD', 'IP65 Weatherproof', 'Extruded Profiles'],
  'led-panel-lights': ['KK Anti-Glare', 'AURA Slim Spots', 'Linear Pendants'],
  'led-street-lights': ['100W–150W Pawza', 'IP66 Die-Cast', 'Landscape Poles'],
  'electrical-accessories': ['STAR Silver', 'Volt Grey Series', 'MCB Breakers'],
  'cables-and-wires': ['Pure Copper 2x1.5–3x6', 'Cat6 Network', 'Coaxial Cable'],
  'fans-and-ventilation': ['High-Flow Ceiling', 'Exhaust Fans', 'Quiet Motors'],
};
---

<section class="py-12 sm:py-16 bg-[#f4f7f6] text-gray-900" id="top-categories-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header (as in mockup) -->
    <div class="flex items-center justify-between gap-4 mb-6 sm:mb-8">
      <div>
        <span class="text-xs font-bold text-[#28e374] uppercase tracking-wider block mb-1" data-i18n="categories.eyebrow">
          OUR PRODUCTS
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0f172a] tracking-tight" data-i18n="categories.title">
          Top Categories
        </h2>
      </div>

      <a
        href="/products"
        class="inline-flex items-center gap-1.5 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full bg-white border border-gray-300 hover:border-gray-400 text-xs sm:text-sm font-bold text-gray-900 shadow-xs hover:bg-gray-50 active:scale-95 transition-all shrink-0"
      >
        <span data-i18n="categories.view_all">View All Products</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- 6 Categories Grid (2 cols mobile, 3 cols desktop) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {categories.map((cat, idx) => {
        const img = categoryImages[cat.slug];
        const keys = i18nKeys[cat.slug];
        const highlights = categoryHighlights[cat.slug] || [];

        return (
          <a
            href={`/products/${cat.slug}`}
            class="group bg-white rounded-2xl border border-gray-200/90 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col overflow-hidden"
            aria-label={`Explore category ${cat.name}`}
          >
            <!-- Product Image -->
            <div class="aspect-[4/3] w-full overflow-hidden bg-gray-50 flex items-center justify-center p-3 sm:p-5 relative">
              {img && (
                <Image
                  src={img}
                  alt={cat.name}
                  width={400}
                  height={300}
                  loading={idx < 3 ? 'eager' : 'lazy'}
                  class="w-full h-full object-contain rounded-xl group-hover:scale-105 transition-transform duration-500"
                />
              )}
              <span class="absolute top-3 left-3 px-2 py-0.5 rounded-md bg-white/90 backdrop-blur-xs text-[10px] font-bold text-gray-700 border border-gray-200 shadow-2xs">
                0{idx + 1} // IN STOCK
              </span>
            </div>

            <!-- Card Bottom Info & Green Arrow Button -->
            <div class="p-4 sm:p-5 flex flex-col justify-between flex-grow gap-3 border-t border-gray-100 bg-white">
              <div>
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-base sm:text-lg font-bold text-[#0f172a] group-hover:text-emerald-600 transition-colors" data-i18n={keys?.title}>
                    {cat.name}
                  </h3>
                </div>
                <p class="text-xs text-gray-500 mt-1 line-clamp-1" data-i18n={keys?.tag}>
                  {cat.tagline}
                </p>

                <!-- Product line highlights -->
                <div class="flex flex-wrap gap-1.5 mt-3 pt-2.5 border-t border-gray-100">
                  {highlights.map((h) => (
                    <span class="px-2 py-0.5 rounded-md bg-gray-50 text-[10px] text-gray-600 border border-gray-200/70 font-medium">
                      {h}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Navigation Prompt & Green Circular Arrow Icon Button -->
              <div class="pt-3 border-t border-gray-100 flex items-center justify-between">
                <span class="text-xs font-semibold text-emerald-600 group-hover:translate-x-0.5 transition-transform">
                  Explore Category &rarr;
                </span>
                <div class="w-8 h-8 rounded-full bg-[#28e374] text-black flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:bg-[#2fd468] transition-all shadow-xs">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
