---
import { Image } from 'astro:assets';
import categories from '../../data/categories.json';

// Import category images
import stripImg from '../../assets/categories/led-strip-lights.jpg';
import panelImg from '../../assets/categories/led-panel-lights.jpg';
import streetImg from '../../assets/categories/led-street-lights.jpg';
import accessoriesImg from '../../assets/categories/electrical-accessories.jpg';
import cablesImg from '../../assets/categories/cables-and-wires.jpg';
import kkSpotImg from '../../assets/categories/kk-spot-lights.jpg';

const categoryImages: Record<string, any> = {
  'led-strip-lights': stripImg,
  'led-panel-lights': panelImg,
  'led-street-lights': streetImg,
  'electrical-accessories': accessoriesImg,
  'cables-and-wires': cablesImg,
  'kk-spot-lights': kkSpotImg,
  'fans-and-ventilation': kkSpotImg,
};

const i18nKeys: Record<string, { title: string; tag: string }> = {
  'led-strip-lights': { title: 'categories.strip_title', tag: 'categories.strip_tag' },
  'led-panel-lights': { title: 'categories.panel_title', tag: 'categories.panel_tag' },
  'led-street-lights': { title: 'categories.street_title', tag: 'categories.street_tag' },
  'electrical-accessories': { title: 'categories.accessories_title', tag: 'categories.accessories_tag' },
  'cables-and-wires': { title: 'categories.cables_title', tag: 'categories.cables_tag' },
  'kk-spot-lights': { title: 'categories.kk_spot_title', tag: 'categories.kk_spot_tag' },
  'fans-and-ventilation': { title: 'categories.kk_spot_title', tag: 'categories.kk_spot_tag' },
};

const categoryHighlights: Record<string, string[]> = {
  'led-strip-lights': ['COB & 2835 SMD', 'IP65 Weatherproof', 'Extruded Profiles'],
  'led-panel-lights': ['AURA Slim Spots', 'Linear Pendants', 'Crystal Glass'],
  'led-street-lights': ['100W–150W Pawza', 'IP66 Die-Cast', 'Landscape Poles'],
  'electrical-accessories': ['STAR Silver', 'Volt Grey Series', 'MCB Breakers'],
  'cables-and-wires': ['Pure Copper 2x1.5–3x6', 'Cat6 Network', 'Coaxial Cable'],
  'kk-spot-lights': ['KK Anti-Glare', 'Deep-Recessed Lens', 'Satin Silver Finish'],
  'fans-and-ventilation': ['KK Anti-Glare', 'Deep-Recessed Lens', 'Satin Silver Finish'],
};
---

<section class="py-12 sm:py-16 bg-[#f4f7f6] text-gray-900" id="top-categories-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header (as in mockup) -->
    <div class="flex items-center justify-between gap-4 mb-6 sm:mb-8">
      <div>
        <span class="text-xs font-bold text-[#28e374] uppercase tracking-wider block mb-1" data-i18n="categories.eyebrow">
          OUR PRODUCTS
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0f172a] tracking-tight" data-i18n="categories.title">
          Top Categories
        </h2>
      </div>

      <a
        href="/products"
        class="inline-flex items-center gap-1.5 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full bg-white border border-gray-300 hover:border-gray-400 text-xs sm:text-sm font-bold text-gray-900 shadow-xs hover:bg-gray-50 active:scale-95 transition-all shrink-0"
      >
        <span data-i18n="categories.view_all">View All Products</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- 6 Categories Grid: Full Images with darkened bottom text overlay -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {categories.map((cat, idx) => {
        const img = categoryImages[cat.slug];
        const keys = i18nKeys[cat.slug];
        const highlights = categoryHighlights[cat.slug] || [];

        return (
          <a
            href={`/products/${cat.slug}`}
            class="group relative rounded-2xl sm:rounded-3xl overflow-hidden border border-gray-300/80 shadow-md hover:shadow-2xl hover:-translate-y-1 transition-all duration-500 flex flex-col justify-between min-h-[420px] sm:min-h-[460px] p-5 sm:p-6 bg-[#04120a]"
            aria-label={`Explore category ${cat.name}`}
          >
            <!-- Full Image Covering Card -->
            {img && (
              <Image
                src={img}
                alt={cat.name}
                width={600}
                height={800}
                loading={idx < 3 ? 'eager' : 'lazy'}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 select-none pointer-events-none"
              />
            )}

            <!-- Dark Gradient: Bottom text area is less bright / darkened for high contrast -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/70 via-50% to-black/15 pointer-events-none transition-opacity duration-300"></div>

            <!-- Top Stock Badge -->
            <div class="relative z-10 flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-[10px] font-bold text-white border border-white/20 shadow-xs">
                0{idx + 1} // IN STOCK
              </span>
            </div>

            <!-- Bottom Info Area Over Darkened Gradient -->
            <div class="relative z-10 flex flex-col gap-3 mt-auto pt-6">
              <div>
                <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-[#28e374] transition-colors" data-i18n={keys?.title}>
                  {cat.name}
                </h3>
                <p class="text-xs sm:text-sm text-gray-300 mt-1 line-clamp-1" data-i18n={keys?.tag}>
                  {cat.tagline}
                </p>

                <!-- Product line highlights -->
                <div class="flex flex-wrap gap-1.5 mt-3 pt-3 border-t border-white/15">
                  {highlights.map((h) => (
                    <span class="px-2.5 py-0.5 rounded-full bg-white/10 backdrop-blur-md text-[10px] text-gray-200 border border-white/20 font-medium">
                      {h}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Navigation Prompt & Green Circular Arrow Icon Button -->
              <div class="pt-3 border-t border-white/15 flex items-center justify-between">
                <span class="text-xs font-bold text-[#28e374] group-hover:translate-x-1 transition-transform">
                  Explore Category &rarr;
                </span>
                <div class="w-9 h-9 rounded-full bg-[#28e374] text-black flex items-center justify-center shrink-0 group-hover:scale-110 group-hover:bg-[#2fd468] transition-all shadow-md">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
