---
import { Image } from 'astro:assets';
import categories from '../../data/categories.json';

// Import category images
import stripImg from '../../assets/categories/led-strip-lights.jpg';
import panelImg from '../../assets/categories/led-panel-lights.jpg';
import streetImg from '../../assets/categories/led-street-lights.jpg';
import accessoriesImg from '../../assets/categories/electrical-accessories.jpg';
import cablesImg from '../../assets/categories/cables-and-wires.jpg';
import fansImg from '../../assets/categories/fans-and-ventilation.jpg';

const categoryImages: Record<string, any> = {
  'led-strip-lights': stripImg,
  'led-panel-lights': panelImg,
  'led-street-lights': streetImg,
  'electrical-accessories': accessoriesImg,
  'cables-and-wires': cablesImg,
  'fans-and-ventilation': fansImg,
};
---

<section class="py-12 sm:py-16 bg-[#f4f7f6] text-gray-900" id="top-categories-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header (as in mockup) -->
    <div class="flex items-center justify-between gap-4 mb-6 sm:mb-8">
      <div>
        <span class="text-xs font-bold text-[#28e374] uppercase tracking-wider block mb-1">
          OUR PRODUCTS
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0f172a] tracking-tight">
          Top Categories
        </h2>
      </div>

      <a
        href="/products"
        class="inline-flex items-center gap-1.5 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full bg-white border border-gray-300 hover:border-gray-400 text-xs sm:text-sm font-bold text-gray-900 shadow-xs hover:bg-gray-50 active:scale-95 transition-all shrink-0"
      >
        <span>View All Products</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- 6 Categories Grid (2 cols mobile, 3 cols desktop) -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3.5 sm:gap-6">
      {categories.map((cat) => {
        const img = categoryImages[cat.slug];
        return (
          <a
            href={`/products/${cat.slug}`}
            class="group bg-white rounded-2xl border border-gray-200/90 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col overflow-hidden"
          >
            <!-- Product Image -->
            <div class="aspect-[4/3] w-full overflow-hidden bg-gray-50 flex items-center justify-center p-2.5 sm:p-4">
              {img && (
                <Image
                  src={img}
                  alt={cat.name}
                  width={400}
                  height={300}
                  class="w-full h-full object-contain rounded-xl group-hover:scale-105 transition-transform duration-500"
                />
              )}
            </div>

            <!-- Card Bottom Info & Green Arrow Button -->
            <div class="p-3 sm:p-4 flex items-center justify-between gap-2 border-t border-gray-100 bg-white">
              <div class="min-w-0 flex-1">
                <h3 class="text-xs sm:text-sm md:text-base font-bold text-[#0f172a] group-hover:text-emerald-600 transition-colors truncate">
                  {cat.name}
                </h3>
                <p class="text-[10px] sm:text-xs text-gray-500 truncate mt-0.5">
                  {cat.tagline}
                </p>
              </div>

              <!-- Green Circular Arrow Icon Button -->
              <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-[#28e374] text-black flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform shadow-xs">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
