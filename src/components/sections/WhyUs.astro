---
import { Image } from 'astro:assets';
import showcaseImg from '../../assets/gallery/warm-luminaire-glow.jpg';
---

<section class="py-16 lg:py-24 bg-[#0B1210] border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left: Value Props (4 items) -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        <div class="inline-flex items-center gap-2 text-xs font-bold text-[#5BE584] uppercase tracking-widest">
          <span>THE LUXURY DIFFERENCE</span>
          <span>•</span>
          <span>WE DELIVER MORE</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          Why Addis Ababa Chooses Luxury Electrical
        </h2>

        <p class="text-base text-[#9BAAA4] leading-relaxed">
          From compact apartment renovations to multi-story commercial real estate in Addis Ababa, our fixtures are selected for photometrics, longevity, and style.
        </p>

        <!-- 4 Grid Features -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2">
          <!-- 1. Premium Quality -->
          <div class="p-5 rounded-2xl bg-[#101413] border border-white/10 hover:border-[#5BE584]/30 transition-all flex flex-col gap-2.5">
            <div class="w-10 h-10 rounded-xl bg-[#5BE584]/10 text-[#5BE584] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </div>
            <h3 class="text-base font-bold text-white">Premium Quality</h3>
            <p class="text-xs text-[#9BAAA4] leading-relaxed">
              Optical-grade diffusers, high CRI color fidelity, and heavy-duty aluminum thermal dissipation.
            </p>
          </div>

          <!-- 2. Affordable Price -->
          <div class="p-5 rounded-2xl bg-[#101413] border border-white/10 hover:border-[#5BE584]/30 transition-all flex flex-col gap-2.5">
            <div class="w-10 h-10 rounded-xl bg-[#5BE584]/10 text-[#5BE584] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h.5c.8 0 1.5-.7 1.5-1.5v-6c0-.8-.7-1.5-1.5-1.5H20c-.2-.6-1-2-1-2z"/>
              </svg>
            </div>
            <h3 class="text-base font-bold text-white">Affordable Wholesale Pricing</h3>
            <p class="text-xs text-[#9BAAA4] leading-relaxed">
              Direct supplier ties in Sosa Merkato eliminate unnecessary middleman markups for contractors and retail buyers.
            </p>
          </div>

          <!-- 3. Fast & Safe Delivery -->
          <div class="p-5 rounded-2xl bg-[#101413] border border-white/10 hover:border-[#5BE584]/30 transition-all flex flex-col gap-2.5">
            <div class="w-10 h-10 rounded-xl bg-[#5BE584]/10 text-[#5BE584] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 18H3c-.6 0-1-.4-1-1V7c0-.6.4-1 1-1h10c.6 0 1 .4 1 1v11"/>
                <path d="M14 9h4l4 4v4c0 .6-.4 1-1 1h-2"/>
                <circle cx="7" cy="18" r="2"/>
                <circle cx="17" cy="18" r="2"/>
              </svg>
            </div>
            <h3 class="text-base font-bold text-white">Fast & Safe Delivery</h3>
            <p class="text-xs text-[#9BAAA4] leading-relaxed">
              Swift order dispatch directly to project sites, warehouses, and homes across metropolitan Addis Ababa.
            </p>
          </div>

          <!-- 4. After Sales Support -->
          <div class="p-5 rounded-2xl bg-[#101413] border border-white/10 hover:border-[#5BE584]/30 transition-all flex flex-col gap-2.5">
            <div class="w-10 h-10 rounded-xl bg-[#5BE584]/10 text-[#5BE584] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
              </svg>
            </div>
            <h3 class="text-base font-bold text-white">After-Sales Support</h3>
            <p class="text-xs text-[#9BAAA4] leading-relaxed">
              Ongoing technical advisory, driver matching for strip lights, and dependable manufacturer backed guarantees.
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Image with Glow -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl group">
          <Image
            src={showcaseImg}
            alt="Warm architectural luminaire lighting showcase"
            width={600}
            height={600}
            class="w-full h-auto object-cover transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#050807] via-transparent to-transparent opacity-60"></div>
          
          <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-[#0B1210]/95 backdrop-blur-md border border-[#5BE584]/30">
            <span class="text-xs font-bold text-[#5BE584] uppercase tracking-wider block">Showroom Experience</span>
            <p class="text-sm font-semibold text-white mt-1">Visit our Sosa Merkato showroom to see all luminaires live.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
