---
// Why Choose Us Section
---

<section class="py-12 sm:py-16 bg-[#f4f7f6] text-gray-900 border-t border-gray-200/60" id="why-us-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8 sm:mb-12">
      <span class="text-xs font-bold text-[#28e374] uppercase tracking-wider block mb-1" data-i18n="why_us.eyebrow">
        WHY CHOOSE US
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0f172a] tracking-tight" data-i18n="why_us.title">
        We Deliver More
      </h2>
    </div>

    <!-- 4 Features (2 cols mobile, 4 cols desktop) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      <!-- 1. Premium Quality -->
      <div class="flex flex-col items-center text-center p-4">
        <div class="w-12 h-12 rounded-2xl bg-white border border-gray-200/80 shadow-xs text-[#28e374] flex items-center justify-center mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h12l4 6-10 12L2 9l4-6z"/>
            <path d="M11 3 8 9l4 12 4-12-3-6"/>
            <path d="M2 9h20"/>
          </svg>
        </div>
        <h3 class="text-sm sm:text-base font-bold text-[#0f172a] mb-1" data-i18n="why_us.quality_title">
          Premium Quality
        </h3>
        <p class="text-xs text-gray-500 leading-relaxed max-w-xs" data-i18n="why_us.quality_desc">
          Only the best brands and genuine products.
        </p>
      </div>

      <!-- 2. Affordable Price -->
      <div class="flex flex-col items-center text-center p-4">
        <div class="w-12 h-12 rounded-2xl bg-white border border-gray-200/80 shadow-xs text-[#28e374] flex items-center justify-center mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8 8a2 2 0 0 0 2.828 0l7.172-7.172a2 2 0 0 0 0-2.828l-8-8z"/>
            <circle cx="7.5" cy="7.5" r="1.5" fill="currentColor"/>
          </svg>
        </div>
        <h3 class="text-sm sm:text-base font-bold text-[#0f172a] mb-1" data-i18n="why_us.price_title">
          Affordable Price
        </h3>
        <p class="text-xs text-gray-500 leading-relaxed max-w-xs" data-i18n="why_us.price_desc">
          Great value for your money.
        </p>
      </div>

      <!-- 3. Fast & Safe Delivery -->
      <div class="flex flex-col items-center text-center p-4">
        <div class="w-12 h-12 rounded-2xl bg-white border border-gray-200/80 shadow-xs text-[#28e374] flex items-center justify-center mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
            <path d="M15 18H9"/>
            <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/>
            <circle cx="17" cy="18" r="2"/>
            <circle cx="7" cy="18" r="2"/>
          </svg>
        </div>
        <h3 class="text-sm sm:text-base font-bold text-[#0f172a] mb-1" data-i18n="why_us.delivery_title">
          Fast & Safe Delivery
        </h3>
        <p class="text-xs text-gray-500 leading-relaxed max-w-xs" data-i18n="why_us.delivery_desc">
          Across Addis Ababa (Merkato and nearby).
        </p>
      </div>

      <!-- 4. After Sales Support -->
      <div class="flex flex-col items-center text-center p-4">
        <div class="w-12 h-12 rounded-2xl bg-white border border-gray-200/80 shadow-xs text-[#28e374] flex items-center justify-center mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
          </svg>
        </div>
        <h3 class="text-sm sm:text-base font-bold text-[#0f172a] mb-1" data-i18n="why_us.support_title">
          After Sales Support
        </h3>
        <p class="text-xs text-gray-500 leading-relaxed max-w-xs" data-i18n="why_us.support_desc">
          We are always here for you.
        </p>
      </div>
    </div>
  </div>
</section>
