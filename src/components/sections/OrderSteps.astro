---
import { Image } from 'astro:assets';
import site from '../../data/site.json';
import browseLightImg from '../../assets/ordering/browse-light.jpg';
import quoteConfirmImg from '../../assets/ordering/quote-confirm.jpg';
import deliveryPickupImg from '../../assets/ordering/delivery-pickup.jpg';

interface Step {
  number: string;
  badge: string;
  title: string;
  description: string;
  linkText: string;
  linkHref: string;
  image: ImageMetadata;
  icon: 'search' | 'quote' | 'truck';
}

const steps: Step[] = [
  {
    number: '01',
    badge: 'STEP 01',
    title: 'Browse & Select Your Light',
    description: 'Explore our wide range of lighting and electrical products. Find the perfect solution for your home, office or project.',
    linkText: 'View Products',
    linkHref: '/products',
    image: browseLightImg,
    icon: 'search',
  },
  {
    number: '02',
    badge: 'STEP 02',
    title: 'Request a Quote & Confirm',
    description: "Contact our team with your selection. We'll confirm the product details, price and availability.",
    linkText: 'Contact Us',
    linkHref: '/contact',
    image: quoteConfirmImg,
    icon: 'quote',
  },
  {
    number: '03',
    badge: 'STEP 03',
    title: 'Delivery or Pickup',
    description: 'Choose collection from our showroom or arrange delivery to your location (subject to confirmation).',
    linkText: 'Delivery Information',
    linkHref: '/contact',
    image: deliveryPickupImg,
    icon: 'truck',
  },
];
---

<section class="py-14 sm:py-20 bg-white relative overflow-hidden border-t border-gray-200/60" id="order-steps-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 sm:mb-14">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <span class="text-xs font-bold text-[#28e374] tracking-widest uppercase">
            HOW IT WORKS
          </span>
          <span class="w-10 h-0.5 bg-[#28e374]/60 rounded-full"></span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0f172a] tracking-tight">
          Simple <span class="text-[#28e374]">3-Step</span> Ordering & Delivery
        </h2>
        <p class="text-xs sm:text-sm text-gray-500 max-w-xl mt-2.5 leading-relaxed">
          Getting the right lighting for your space is easy. Follow these three simple steps and we'll take care of the rest.
        </p>
      </div>

      <!-- Top Right Badges -->
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-300 hover:border-gray-400 bg-[#f4f7f6] hover:bg-gray-100 text-xs font-semibold text-gray-900 transition-all shadow-2xs"
        >
          <svg class="text-[#28e374]" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>Ordering Guide</span>
        </a>

        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-300 hover:border-gray-400 bg-[#f4f7f6] hover:bg-gray-100 text-xs font-semibold text-gray-900 transition-all shadow-2xs"
        >
          <svg class="text-[#28e374]" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="13" x="1" y="3" rx="2"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
          <span>Delivery Info</span>
        </a>
      </div>
    </div>

    <!-- 3 Step Cards Layout with Intermediate Desktop Arrows -->
    <div class="flex flex-col lg:flex-row items-stretch gap-4 lg:gap-3">
      {steps.map((step, idx) => (
        <>
          <div class="flex-1 group bg-[#07190f]/90 border border-emerald-900/60 hover:border-[#28e374]/70 rounded-2xl sm:rounded-3xl p-5 sm:p-6 flex flex-col justify-between transition-all duration-300 hover:shadow-[0_0_30px_rgba(40,227,116,0.12)]">
            <!-- Top Row: Icon & Step Badge -->
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-950/80 border border-emerald-500/40 text-[#28e374] flex items-center justify-center shrink-0 shadow-sm">
                {step.icon === 'search' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                )}
                {step.icon === 'quote' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <path d="m9 15 2 2 4-4"></path>
                  </svg>
                )}
                {step.icon === 'truck' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="16" height="13" x="1" y="3" rx="2"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                )}
              </div>

              <span class="px-3 py-1 rounded-full border border-emerald-500/40 bg-emerald-950/90 text-[10px] font-bold text-emerald-300 uppercase tracking-wider">
                {step.badge}
              </span>
            </div>

            <!-- Main Content + Side Thumbnail -->
            <div class="flex items-start justify-between gap-3 my-2 flex-grow">
              <div class="flex flex-col justify-between h-full">
                <div>
                  <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-[#28e374] transition-colors leading-snug mb-2">
                    {step.title}
                  </h3>
                  <p class="text-xs text-gray-300/90 leading-relaxed">
                    {step.description}
                  </p>
                </div>

                <a
                  href={step.linkHref}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-[#28e374] group-hover:text-emerald-300 transition-colors mt-4"
                >
                  <span>{step.linkText}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>

              <!-- Step Image Thumbnail -->
              <div class="w-20 sm:w-24 lg:w-24 xl:w-28 aspect-[3/4] shrink-0 rounded-xl overflow-hidden bg-emerald-950/60 shadow-inner">
                <Image
                  src={step.image}
                  alt={step.title}
                  width={220}
                  height={290}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            </div>
          </div>

          <!-- Intermediate Arrow (desktop) -->
          {idx < steps.length - 1 && (
            <div class="hidden lg:flex w-8 h-8 rounded-full bg-emerald-950/90 border border-emerald-500/40 text-[#28e374] items-center justify-center shrink-0 self-center z-10 shadow-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          )}
        </>
      ))}
    </div>

    <!-- Bottom Contact & Help Banner -->
    <div class="mt-8 sm:mt-10 p-4 sm:p-5 rounded-2xl sm:rounded-3xl bg-[#07190f]/90 border border-emerald-900/60 shadow-xl flex flex-col md:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-3.5 text-center sm:text-left">
        <div class="w-12 h-12 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-[#28e374] flex items-center justify-center shrink-0 shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-sm sm:text-base font-bold text-white">Need help or a custom order?</h4>
          <p class="text-xs text-gray-300 mt-0.5">Our team is ready to assist you with product selection, pricing and delivery.</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto justify-center">
        <button
          type="button"
          class="trigger-call-modal px-5 py-2.5 rounded-full bg-[#28e374] hover:bg-[#2fd468] text-black font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all shadow-md active:scale-95 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>Call the Showroom</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>

        <a
          href={site.telegram.inbox}
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-full border border-emerald-500/40 hover:border-[#28e374] bg-emerald-950/50 text-white font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all active:scale-95"
        >
          <svg class="text-[#28e374]" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          <span>Contact on Telegram</span>
        </a>
      </div>
    </div>
  </div>
</section>
