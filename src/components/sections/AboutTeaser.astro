---
import { Image } from 'astro:assets';
import panelImg from '../../assets/products/led-panel-lights/mini-spot-white.jpg';
import displayWallImg from '../../assets/about/display-wall.jpg';
import streetImg from '../../assets/products/led-street-lights/street-light-150w.jpg';
import rgbImg from '../../assets/products/led-strip-lights/rgb-strip-reel.jpg';
import site from '../../data/site.json';
---

<section class="py-6 sm:py-10 bg-[#f4f7f6]" id="about-teaser-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Dark Card Container (matching mockup) -->
    <div class="rounded-3xl bg-[#04120a] border border-emerald-950/80 p-6 sm:p-10 lg:p-12 shadow-2xl relative overflow-hidden">
      <!-- Ambient light effect -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#28e374]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
        <!-- Left: Text & Features -->
        <div class="lg:col-span-7 flex flex-col items-start text-left">
          <span class="text-xs font-bold text-[#28e374] tracking-wider uppercase mb-1.5 block">
            ABOUT US
          </span>

          <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight mb-3">
            Luxury Electrical
          </h2>

          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed max-w-xl mb-6">
            Luxury Electrical is your trusted partner for high-quality electrical and lighting solutions. We provide a wide range of products including LED lights, panels, street lights, electrical accessories, cables, fans and more — all at the best prices and with excellent service.
          </p>

          <!-- 3 Features Row -->
          <div class="grid grid-cols-3 gap-2 sm:gap-4 w-full max-w-lg mb-6">
            <!-- Feature 1 -->
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-md bg-[#28e374]/15 text-[#28e374] flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              </div>
              <span class="text-[11px] sm:text-xs font-semibold text-white leading-tight">
                Original<br />Products
              </span>
            </div>

            <!-- Feature 2 -->
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-md bg-[#28e374]/15 text-[#28e374] flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"/>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
              </div>
              <span class="text-[11px] sm:text-xs font-semibold text-white leading-tight">
                Professional<br />Service
              </span>
            </div>

            <!-- Feature 3 -->
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-md bg-[#28e374]/15 text-[#28e374] flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <polyline points="16 11 18 13 22 9"/>
                </svg>
              </div>
              <span class="text-[11px] sm:text-xs font-semibold text-white leading-tight">
                Customer<br />Satisfaction
              </span>
            </div>
          </div>

          <!-- Learn More Button -->
          <a
            href="/about"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-transparent border border-[#28e374] text-[#28e374] hover:bg-[#28e374] hover:text-black font-bold text-xs sm:text-sm transition-all active:scale-95"
          >
            <span>Learn More</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Right: 2x2 Photo Grid & Script Text -->
        <div class="lg:col-span-5 flex flex-col items-end">
          <div class="grid grid-cols-2 gap-3 w-full">
            <div class="rounded-2xl overflow-hidden bg-white/5 border border-white/10 aspect-square">
              <Image
                src={panelImg}
                alt="LED Panel Light"
                width={300}
                height={300}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="rounded-2xl overflow-hidden bg-white/5 border border-white/10 aspect-square">
              <Image
                src={displayWallImg}
                alt="Showroom Lighting Display"
                width={300}
                height={300}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="rounded-2xl overflow-hidden bg-white/5 border border-white/10 aspect-square">
              <Image
                src={streetImg}
                alt="LED Street Lights"
                width={300}
                height={300}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="rounded-2xl overflow-hidden bg-white/5 border border-white/10 aspect-square">
              <Image
                src={rgbImg}
                alt="RGB Strip Lights Reel"
                width={300}
                height={300}
                class="w-full h-full object-cover"
              />
            </div>
          </div>

          <!-- Script Branding Callout -->
          <div class="mt-4 text-right pr-2">
            <span class="font-serif italic font-bold text-lg sm:text-2xl text-[#28e374] tracking-wide inline-block drop-shadow-[0_0_12px_rgba(40,227,116,0.6)] transform -rotate-1">
              Quality Products<br />
              Brighter Future
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
