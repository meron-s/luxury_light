---
import site from '../../data/site.json';
import { toTel } from '../../lib/phone';
---

<section id="contact-bar" class="py-8 sm:py-12 bg-[#f4f7f6] scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Dark Card Container -->
    <div class="rounded-3xl bg-[#04120a] border border-emerald-950/90 p-6 sm:p-8 lg:p-10 text-white shadow-2xl relative overflow-hidden">
      <!-- Glow effect -->
      <div class="absolute -bottom-20 -right-20 w-80 h-80 bg-[#28e374]/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Top Row: Call Ordering & Location -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 items-center pb-6 border-b border-white/10 relative z-10">
        <!-- Left: Order by Call & Numbers -->
        <div class="md:col-span-7 flex flex-col gap-3">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-[#28e374] text-black flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-1.57 1.97c-2.83-1.35-5.43-3.9-6.83-6.82l1.97-1.61c.29-.26.37-.65.25-1.02A11.36 11.36 0 0 1 8.72 4c0-.55-.45-1-1-1H4.08c-.55 0-1 .45-1 1C3.08 13.28 10.73 20.92 20.01 20.92c.55 0 1-.45 1-1v-3.54c0-.55-.45-1-1-1z"/>
              </svg>
            </div>
            <span class="text-sm sm:text-base font-bold text-white" data-i18n="contact.order_call">
              Order by Call
            </span>
          </div>

          <!-- Numbers in 2 Columns -->
          <div class="grid grid-cols-2 gap-x-4 gap-y-1.5 pt-1">
            <a href={toTel("0911948627")} class="text-base sm:text-lg font-extrabold text-white hover:text-[#28e374] transition-colors tracking-tight">
              0911948627
            </a>
            <a href={toTel("0935021157")} class="text-base sm:text-lg font-extrabold text-white hover:text-[#28e374] transition-colors tracking-tight">
              0935021157
            </a>
            <a href={toTel("0910404241")} class="text-base sm:text-lg font-extrabold text-white hover:text-[#28e374] transition-colors tracking-tight">
              0910404241
            </a>
            <a href={toTel("0910210089")} class="text-base sm:text-lg font-extrabold text-white hover:text-[#28e374] transition-colors tracking-tight">
              0910210089
            </a>
          </div>
        </div>

        <!-- Vertical Divider (desktop) -->
        <div class="hidden md:block md:col-span-1 border-r border-white/10 h-20 my-auto"></div>

        <!-- Right: Location & Amharic Slogan -->
        <div class="md:col-span-4 flex items-center justify-between gap-4">
          <div class="flex items-start gap-2.5">
            <div class="w-8 h-8 rounded-full bg-[#28e374]/15 text-[#28e374] flex items-center justify-center shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="text-sm font-bold text-white" data-i18n="contact.city">Addis Ababa</span>
              <span class="text-xs text-gray-400" data-i18n="contact.area">Merkato</span>
            </div>
          </div>

          <div class="text-right">
            <span class="font-serif italic font-extrabold text-xl sm:text-2xl text-[#28e374] drop-shadow-[0_0_10px_rgba(40,227,116,0.5)] whitespace-nowrap transform -rotate-2 inline-block">
              Luxury ይገባዎታል!
            </span>
          </div>
        </div>
      </div>

      <!-- Bottom Row: Telegram Integrations -->
      <div class="pt-5 flex flex-col sm:flex-row items-center justify-between gap-4 relative z-10">
        <!-- 1. Inbox Button -->
        <a
          href={site.telegram.inbox}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-white/5 border border-white/10 hover:border-[#2AABEE]/60 text-xs font-semibold text-white transition-all shadow-xs"
        >
          <div class="w-5 h-5 rounded-full bg-[#2AABEE] text-white flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
          </div>
          <span data-i18n="contact.inbox">Inbox me @Rezured</span>
        </a>

        <!-- 2. Channel URL -->
        <a
          href={site.telegram.channel}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-[#28e374] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
          <span>https://t.me/luxuryelectrical</span>
        </a>

        <!-- 3. Join Pill Button -->
        <a
          href={site.telegram.channel}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2 rounded-full bg-[#28e374] text-black font-extrabold text-xs tracking-wider shadow-md hover:bg-[#22c55e] active:scale-95 transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
          <span data-i18n="contact.join">....... join ....... &rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
