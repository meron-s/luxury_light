---
import { Image } from 'astro:assets';
import logoImg from '../../assets/brand/logo.png';
import site from '../../data/site.json';
---

<footer class="bg-[#030906] text-[#C1C8C4] border-t border-white/10 py-5 sm:py-6 relative z-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Left: Brand Logo -->
    <a href="/" class="flex items-center gap-2">
      <Image
        src={logoImg}
        alt={`${site.name} logo`}
        width={160}
        height={50}
        class="h-8 sm:h-10 w-auto object-contain"
      />
    </a>

    <!-- Center: Amharic Brand Script -->
    <div class="text-center">
      <span class="font-serif italic font-extrabold text-lg sm:text-2xl text-[#28e374] tracking-wider drop-shadow-[0_0_10px_rgba(40,227,116,0.5)] transform -rotate-2 inline-block">
        Luxury ይገባዎታል!
      </span>
    </div>

    <!-- Right: Addis Ababa Skyline Silhouette -->
    <div class="flex flex-col items-center md:items-end gap-1">
      <!-- Addis Ababa Skyline Vector (including CBE Tower profile) -->
      <svg class="h-8 w-auto text-white/50" viewBox="0 0 240 50" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <!-- Ground base -->
        <rect y="48" width="240" height="2" fill="currentColor"/>
        <!-- Background buildings -->
        <path d="M5 48V32h8v16M18 48V25h12v23M35 48V35h10v13M50 48V28h8v20M62 48V38h7v10" opacity="0.4"/>
        <path d="M72 48V22h14v26M90 48V30h11v18M105 48V18h16v30" opacity="0.6"/>
        <!-- CBE Tower (Center High-Rise Landmark) -->
        <path d="M128 48V8l3-5 3 5v40h-6z" fill="#28e374" opacity="0.85"/>
        <line x1="131" y1="3" x2="131" y2="0" stroke="#28e374" stroke-width="1.5"/>
        <path d="M136 48V20h12v28M152 48V34h10v14" opacity="0.5"/>
        <path d="M166 48V26h15v22M185 48V16h14v32M203 48V32h12v16M219 48V36h14v12" opacity="0.5"/>
        <!-- Architectural roof detail -->
        <path d="M107 18l6-4 6 4" stroke="currentColor" stroke-width="1" fill="none"/>
        <circle cx="131" cy="1" r="1" fill="#28e374"/>
      </svg>
      <span class="text-[10px] sm:text-xs text-gray-400 font-medium tracking-wide">
        Addis Ababa, Ethiopia
      </span>
    </div>
  </div>
</footer>
