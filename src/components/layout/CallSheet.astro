---
import site from '../../data/site.json';
import { formatPhone, toTel } from '../../lib/phone';
---

<div id="call-sheet-modal" class="fixed inset-0 z-[130]" role="dialog" aria-modal="true" aria-labelledby="call-sheet-title">
  <!-- Backdrop -->
  <div id="call-sheet-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-sm cursor-pointer"></div>

  <!-- Bottom Sheet Container -->
  <div class="fixed inset-x-0 bottom-0 z-10 flex justify-center pointer-events-none p-0 sm:p-4">
    <div
      id="call-sheet-content"
      class="w-full max-w-lg bg-[#0B1210] border-t sm:border border-[#5BE584]/20 rounded-t-[2rem] sm:rounded-3xl p-6 shadow-2xl pointer-events-auto flex flex-col gap-5"
    >
      <!-- Drag pill -->
      <div class="w-12 h-1.5 bg-white/20 rounded-full mx-auto"></div>

      <!-- Header -->
      <div class="text-center flex flex-col gap-1">
        <h2 id="call-sheet-title" class="text-xl font-bold text-white tracking-tight">Choose a Showroom Line to Call</h2>
        <p id="call-sheet-subtitle" class="text-sm text-[#9BAAA4]">Connect directly with our team at Sosa Merkato Building</p>
      </div>

      <!-- 4 Phone options -->
      <div class="flex flex-col gap-2.5">
        {site.phones.map((phone) => (
          <a
            href={toTel(phone.number)}
            class="flex items-center justify-between p-3.5 rounded-xl bg-[#1C201F] border border-white/10 hover:border-[#5BE584]/50 active:scale-[0.98] transition-all group"
          >
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 rounded-lg bg-[#5BE584]/10 border border-[#5BE584]/30 flex items-center justify-center text-[#5BE584] group-hover:bg-[#5BE584] group-hover:text-[#050807] transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div class="flex flex-col text-left">
                <span class="text-base font-semibold text-white group-hover:text-[#5BE584] transition-colors">{formatPhone(phone.number)}</span>
                <span class="text-xs text-[#9BAAA4]">{phone.label}</span>
              </div>
            </div>
            <svg class="text-[#9BAAA4] group-hover:text-[#5BE584] transition-colors" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </a>
        ))}
      </div>

      <!-- Dismiss Button -->
      <button
        type="button"
        onclick="window.__closeCallModal ? window.__closeCallModal() : null"
        class="call-sheet-close w-full py-3 rounded-xl bg-[#272B29] border border-white/10 text-white font-medium hover:bg-[#323634] transition-colors active:scale-95 cursor-pointer"
      >
        Dismiss
      </button>
    </div>
  </div>
</div>

<script is:inline>
  window.__openCallModal = function(productName) {
    var modal = document.getElementById('call-sheet-modal');
    if (!modal) return;
    var title = document.getElementById('call-sheet-title');
    var subtitle = document.getElementById('call-sheet-subtitle');
    if (productName && typeof productName === 'string' && productName.trim().length > 0) {
      if (title) title.textContent = 'Request Price & Order';
      if (subtitle) subtitle.textContent = 'Inquiring for: ' + productName;
    } else {
      if (title) title.textContent = 'Choose a Showroom Line to Call';
      if (subtitle) subtitle.textContent = 'Connect directly with our team at Sosa Merkato Building';
    }
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('modal-open');
    document.body.style.overflow = 'hidden';
  };
  window.__closeCallModal = function() {
    var modal = document.getElementById('call-sheet-modal');
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('modal-open');
    document.body.style.overflow = '';
  };
</script>

<script src="../../scripts/call-sheet.ts"></script>
