---
import { Image } from 'astro:assets';
import logoImg from '../../assets/brand/logo.png';
import site from '../../data/site.json';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: '/products' },
  { label: 'About Us', href: '/about' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-40 w-full bg-[#050807]/95 backdrop-blur-md border-b border-white/10 shadow-xl transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#5BE584] rounded-lg p-1">
      <Image
        src={logoImg}
        alt={`${site.name} logo`}
        width={160}
        height={160}
        class="w-14 h-14 object-contain drop-shadow-[0_0_8px_rgba(91,229,132,0.3)] transition-transform duration-300 group-hover:scale-105"
      />
      <div class="flex flex-col">
        <span class="text-[10px] font-semibold text-[#9BAAA4] tracking-widest uppercase">ELECTRICAL SHOWROOM • ADDIS ABABA</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main Navigation">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`text-sm font-semibold transition-all py-1 relative ${
              isActive
                ? 'text-[#5BE584]'
                : 'text-[#C1C8C4] hover:text-white'
            }`}
          >
            {item.label}
            {isActive && (
              <span class="absolute bottom-0 inset-x-0 h-0.5 bg-[#5BE584] rounded-full shadow-neon-glow"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Desktop Action CTAs -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href={site.telegram.inbox}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Direct Telegram Architect Inbox"
        class="hidden lg:flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#1C201F] border border-white/10 hover:border-[#2AABEE]/50 text-xs font-semibold text-white transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2AABEE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
        <span>{site.telegram.inboxHandle}</span>
      </a>

      <!-- Call Now button (per SPEC 3.4: on mobile opens sheet, on desktop scrolls to contact bar) -->
      <button
        type="button"
        class="trigger-call-modal flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-[#5BE584] text-[#050807] font-bold text-sm tracking-wide shadow-neon-glow hover:bg-[#2FD468] hover:shadow-neon-glow-lg active:scale-95 transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>Call Now</span>
      </button>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="menu-open-btn"
        type="button"
        aria-label="Open navigation menu"
        class="w-10 h-10 rounded-xl bg-[#1C201F] border border-white/10 flex items-center justify-center text-white hover:text-[#5BE584] active:scale-95 transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>
