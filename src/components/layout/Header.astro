---
import { Image } from 'astro:assets';
import logoImg from '../../assets/brand/logo.png';
import site from '../../data/site.json';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: '/products' },
  { label: 'About Us', href: '/about' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-40 w-full bg-[#060b08]/95 backdrop-blur-md border-b border-white/10 shadow-lg transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 sm:h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#28e374] rounded-lg">
      <Image
        src={logoImg}
        alt={`${site.name} logo`}
        width={180}
        height={60}
        class="h-10 sm:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-7 lg:gap-8" aria-label="Main Navigation">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`text-sm font-semibold transition-all py-1 relative ${
              isActive
                ? 'text-[#28e374]'
                : 'text-[#C1C8C4] hover:text-white'
            }`}
          >
            {item.label}
            {isActive && (
              <span class="absolute bottom-0 inset-x-0 h-0.5 bg-[#28e374] rounded-full shadow-[0_0_8px_rgba(40,227,116,0.6)]"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Action CTAs (Call Now visible on BOTH mobile & desktop) -->
    <div class="flex items-center gap-2.5 sm:gap-4">
      <!-- Call Now button -->
      <button
        type="button"
        class="trigger-call-modal flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-full bg-[#28e374] text-black font-extrabold text-xs sm:text-sm tracking-wide shadow-md shadow-[#28e374]/25 hover:bg-[#22c55e] active:scale-95 transition-all cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="shrink-0">
          <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-1.57 1.97c-2.83-1.35-5.43-3.9-6.83-6.82l1.97-1.61c.29-.26.37-.65.25-1.02A11.36 11.36 0 0 1 8.72 4c0-.55-.45-1-1-1H4.08c-.55 0-1 .45-1 1C3.08 13.28 10.73 20.92 20.01 20.92c.55 0 1-.45 1-1v-3.54c0-.55-.45-1-1-1z"/>
        </svg>
        <span>Call Now</span>
      </button>

      <!-- Mobile Hamburger Toggle -->
      <button
        id="menu-open-btn"
        type="button"
        aria-label="Open navigation menu"
        class="md:hidden w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white hover:text-[#28e374] active:scale-95 transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>
