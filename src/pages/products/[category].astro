---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import categories from '../../data/categories.json';
import products from '../../data/products.json';
import site from '../../data/site.json';
import fallbackHero from '../../assets/hero/hero-main.jpg';

// Category cover images
import stripImg from '../../assets/categories/led-strip-lights.jpg';
import panelImg from '../../assets/categories/led-panel-lights.jpg';
import streetImg from '../../assets/categories/led-street-lights.jpg';
import accessoriesImg from '../../assets/categories/electrical-accessories.jpg';
import cablesImg from '../../assets/categories/cables-and-wires.jpg';
import fansImg from '../../assets/categories/fans-and-ventilation.jpg';

const categoryImages: Record<string, any> = {
  'led-strip-lights': stripImg,
  'led-panel-lights': panelImg,
  'led-street-lights': streetImg,
  'electrical-accessories': accessoriesImg,
  'cables-and-wires': cablesImg,
  'fans-and-ventilation': fansImg,
};

// Map all product images
const productImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/**/*.{jpg,png,jpeg}', { eager: true });

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const categoryProducts = products.filter((p) => p.category === category.slug);
const coverImage = categoryImages[category.slug] || fallbackHero;

const siteUrl = 'https://luxury-light.vercel.app';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Products",
      "item": `${siteUrl}/products`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": category.name,
      "item": `${siteUrl}/products/${category.slug}`
    }
  ]
};

const categoryItemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${category.name} — Luxury Electrical Addis Ababa`,
  "description": category.description,
  "numberOfItems": categoryProducts.length,
  "itemListElement": categoryProducts.map((prod, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Product",
      "name": prod.name,
      "description": prod.description,
      "offers": {
        "@type": "Offer",
        "priceCurrency": "ETB",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "Organization",
          "name": "Luxury Electrical & Lighting"
        }
      }
    }
  }))
};
---

<BaseLayout
  title={`${category.name} in Addis Ababa | Wholesale & Retail | Luxury Electrical`}
  description={`${category.description} Inquire directly by phone or Telegram for current stock and contractor volume prices at Sosa Merkato, Addis Ababa.`}
  currentPath={`/products/${category.slug}`}
  extraJsonLd={[breadcrumbSchema, categoryItemListSchema]}
>
  <!-- Category Hero Banner -->
  <section class="relative py-16 lg:py-24 bg-[#0B1210] border-b border-white/10 overflow-hidden">
    <!-- Background Cover with Overlay -->
    <div class="absolute inset-0 z-0">
      <Image
        src={coverImage}
        alt={category.name}
        width={1400}
        height={600}
        class="w-full h-full object-cover filter brightness-[0.25] blur-sm scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#0B1210] via-[#0B1210]/80 to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-[#9BAAA4] mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#5BE584] transition-colors">Home</a>
        <span>/</span>
        <a href="/products" class="hover:text-[#5BE584] transition-colors">Products</a>
        <span>/</span>
        <span class="text-white font-medium">{category.name}</span>
      </nav>

      <div class="max-w-3xl flex flex-col gap-4">
        <div class="inline-flex items-center gap-2 text-xs font-bold text-[#5BE584] uppercase tracking-widest">
          <span>{category.name_am}</span>
          <span>•</span>
          <span>OFFICIAL SPECIFICATIONS</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          {category.name}
        </h1>

        <p class="text-base sm:text-lg text-[#C1C8C4] leading-relaxed">
          {category.description}
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-4">
          <button
            type="button"
            class="trigger-call-modal px-6 py-3 rounded-full bg-[#5BE584] text-[#050807] font-bold text-sm hover:bg-[#2FD468] shadow-neon-glow transition-all active:scale-95 flex items-center gap-2 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>Inquire by Phone</span>
          </button>

          <a
            href={site.telegram.inbox}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-full bg-white border border-[#2AABEE]/40 text-[#2AABEE] hover:bg-[#2AABEE]/10 font-bold text-sm transition-all flex items-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
            <span>Ask via Telegram</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Products Grid -->
  <section class="py-16 bg-white min-h-[500px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between border-b border-gray-200 pb-4 mb-8">
        <h2 class="text-xl font-bold text-[#0f172a]">
          Available {category.name} ({categoryProducts.length} items)
        </h2>
        <a href="/products" class="text-xs font-bold text-[#5BE584] hover:underline">
          ← Back to All Categories
        </a>
      </div>

      {categoryProducts.length === 0 ? (
        <div class="text-center py-16 px-6 rounded-3xl bg-[#f4f7f6] border border-gray-200 max-w-xl mx-auto my-4">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[#28e374]/15 text-[#28e374] mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">New {category.name} Arrivals Coming Soon</h3>
          <p class="text-sm text-gray-600 mb-6 leading-relaxed">
            We are restocking this collection with fresh arrivals. Inquire directly with our showroom or check daily drops on Telegram.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <button
              type="button"
              data-product-name={`${category.name} Inquiry`}
              class="trigger-call-modal px-6 py-2.5 rounded-full bg-[#28e374] text-[#050807] font-bold text-xs sm:text-sm hover:bg-[#2FD468] transition-all cursor-pointer"
            >
              Call Showroom
            </button>
            <a
              href={site.telegram.channel}
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-2.5 rounded-full bg-[#18201d] text-[#2aa8e8] hover:bg-[#2aa8e8]/15 font-semibold text-xs sm:text-sm transition-all"
            >
              Join @luxuryelectrical
            </a>
          </div>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {categoryProducts.map((prod) => {
          const imgModule = productImages[prod.image]?.default || fallbackHero;
          const telegramPrefill = encodeURIComponent(`Hello, I want to inquire about: ${prod.name}`);
          const telegramUrl = `${site.telegram.inbox}?text=${telegramPrefill}`;

          return (
            <div class="group rounded-2xl sm:rounded-3xl bg-white border border-gray-200 hover:border-[#28e374]/50 shadow-sm transition-all duration-300 flex flex-col justify-between overflow-hidden hover:shadow-2xl hover:-translate-y-1">
              <!-- Edge-to-Edge Image & Floating Badge -->
              <div class="relative w-full aspect-[16/10] bg-gray-50 overflow-hidden">
                <Image
                  src={imgModule}
                  alt={prod.name}
                  width={600}
                  height={375}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />

                {prod.badge && (
                  <span class={`absolute top-3 left-3 z-10 px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-black uppercase tracking-wider shadow-sm ${
                    prod.badge === 'Featured'
                      ? 'bg-[#28e374] text-[#050807]'
                      : prod.badge === 'New'
                        ? 'bg-[#5BE584] text-[#050807]'
                        : 'bg-[#2AABEE] text-white'
                  }`}>
                    {prod.badge}
                  </span>
                )}

                <!-- Top-Right Category Badge -->
                <div class="absolute top-3 right-3 z-10">
                  <span class="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-[10px] sm:text-[11px] font-bold uppercase tracking-wider border border-white/20 shadow-sm">
                    {prod.category.replace(/-/g, ' ')}
                  </span>
                </div>
              </div>

              <!-- Card Middle: Product Info -->
              <div class="p-5 flex flex-col gap-3 flex-grow justify-between">
                <div>
                  <h3 class="text-base sm:text-lg font-bold text-[#0f172a] group-hover:text-[#28e374] transition-colors leading-snug">
                    {prod.name}
                  </h3>
                  <p class="text-xs sm:text-sm text-gray-500 mt-1.5 line-clamp-2 leading-relaxed">
                    {prod.description}
                  </p>
                </div>

                <!-- Technical Specs Pill Chips with Icons -->
                <div class="flex flex-wrap gap-2 pt-3 border-t border-gray-100">
                  {prod.specs.ip && (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#f4f7f6] border border-gray-200 text-[11px] font-semibold text-gray-600">
                      <svg class="shrink-0 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      </svg>
                      {prod.specs.ip}
                    </span>
                  )}
                  {prod.specs.color && (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#f4f7f6] border border-gray-200 text-[11px] font-semibold text-gray-600">
                      <svg class="shrink-0 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <circle cx="12" cy="12" r="4"/>
                        <line x1="21.17" y1="8" x2="12" y2="8"/>
                        <line x1="3.95" y1="6.06" x2="8.54" y2="14"/>
                        <line x1="10.88" y1="21.94" x2="15.46" y2="14"/>
                      </svg>
                      {prod.specs.color}
                    </span>
                  )}
                  {prod.specs.watt && (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#f4f7f6] border border-gray-200 text-[11px] font-semibold text-gray-600">
                      <svg class="shrink-0 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"/>
                        <line x1="12" y1="1" x2="12" y2="3"/>
                        <line x1="12" y1="21" x2="12" y2="23"/>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                        <line x1="1" y1="12" x2="3" y2="12"/>
                        <line x1="21" y1="12" x2="23" y2="12"/>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                      </svg>
                      {prod.specs.watt}
                    </span>
                  )}
                </div>

                <!-- Confirm Specs Prompt -->
                <div class="flex items-center gap-1.5 text-[11px] text-[#5BE584] font-medium pt-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>Confirm specifications</span>
                </div>
              </div>

              <!-- Card Bottom: Dual Action Buttons -->
              <div class="px-5 pb-5 grid grid-cols-2 gap-2.5">
                <button
                  type="button"
                  data-product-name={prod.name}
                  class="trigger-call-modal w-full py-2.5 px-3 rounded-full bg-[#28e374] text-[#050807] font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 hover:bg-[#2FD468] transition-all active:scale-95 shadow-sm cursor-pointer"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  <span>Call to Order</span>
                </button>

                <a
                  href={telegramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-2.5 px-3 rounded-full bg-[#18201d] border border-gray-700/60 hover:border-[#2aa8e8]/60 hover:bg-[#2aa8e8]/15 text-[#2aa8e8] font-semibold text-xs sm:text-sm flex items-center justify-center gap-1.5 transition-all active:scale-95"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"/>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                  </svg>
                  <span>Telegram</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>
      )}
    </div>
  </section>
</BaseLayout>
