---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import products from '../../data/products.json';
import categories from '../../data/categories.json';
import site from '../../data/site.json';
import fallbackHero from '../../assets/hero/hero-main.jpg';

// Automatically import all product images for Sharp optimization
const productImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/**/*.{jpg,png,jpeg}', { eager: true });
---

<BaseLayout
  title={`Products Catalog // ${site.name} — Lighting & Electrical Fixtures Addis Ababa`}
  description="Explore our complete catalog of LED strip lights, recessed spotlights, roadway luminaires, STAR switches, copper cables, and electrical accessories in Addis Ababa."
  currentPath="/products"
>
  <div class="py-12 lg:py-16 bg-[#050807] min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Catalog Header -->
      <div class="flex flex-col gap-4 text-center max-w-3xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 justify-center text-xs font-bold text-[#5BE584] uppercase tracking-widest" data-i18n="catalog.badge">
          CATALOG • ARCHITECTURAL & COMMERCIAL SPECIFICATIONS
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight" data-i18n="catalog.title">
          Complete Fixtures & Supplies Portfolio
        </h1>
        <p class="text-sm sm:text-base text-[#9BAAA4] leading-relaxed" data-i18n="catalog.desc">
          Filter by category or search our inventory. All products can be ordered immediately via phone or Telegram.
        </p>
      </div>

      <!-- Search & Filters Container -->
      <div class="flex flex-col gap-6 mb-10">
        <!-- Search Input -->
        <div class="relative max-w-xl mx-auto w-full">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-[#9BAAA4]">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
          </div>
          <input
            id="product-search-input"
            type="search"
            placeholder="Search fixtures by keyword (e.g., spot, breaker, cable, RGB, 150W)..."
            data-i18n-placeholder="catalog.search_placeholder"
            class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-[#0B1210] border border-white/10 text-white placeholder-[#9BAAA4] focus:outline-none focus:border-[#5BE584] transition-colors text-sm shadow-inner"
          />
        </div>

        <!-- Category Filter Chips -->
        <div class="flex flex-wrap items-center justify-center gap-2 max-w-4xl mx-auto" role="tablist" aria-label="Category Filters">
          <button
            type="button"
            data-category="all"
            class="filter-chip active px-4 py-2 rounded-xl text-xs font-bold tracking-wider uppercase border transition-all hover:scale-105 active:scale-95"
          >
            All Products ({products.length})
          </button>
          {categories.map((cat) => {
            const catCount = products.filter(p => p.category === cat.slug).length;
            return (
              <button
                type="button"
                data-category={cat.slug}
                class="filter-chip px-4 py-2 rounded-xl text-xs font-bold tracking-wider uppercase border transition-all hover:scale-105 active:scale-95"
              >
                {cat.name} ({catCount})
              </button>
            );
          })}
        </div>

        <!-- Product Count Indicator -->
        <div class="flex justify-between items-center text-xs text-[#9BAAA4] border-b border-white/10 pb-4">
          <span id="product-count">Showing {products.length} of {products.length} products</span>
          <span class="text-[11px] text-[#5BE584]">Wholesale & Retail pricing via direct inquiry</span>
        </div>
      </div>

      <!-- Product Cards Grid -->
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {products.map((prod) => {
          const imgModule = productImages[prod.image]?.default || fallbackHero;
          const telegramPrefill = encodeURIComponent(`Hello, I am interested in ordering: ${prod.name}`);
          const telegramUrl = `${site.telegram.inbox}?text=${telegramPrefill}`;

          return (
            <div
              class="product-card group rounded-2xl bg-[#0B1210] border border-white/10 hover:border-[#5BE584]/50 transition-all duration-300 flex flex-col justify-between overflow-hidden hover:shadow-2xl hover:-translate-y-1"
              data-category={prod.category}
              data-name={prod.name}
              data-desc={prod.description}
            >
              <!-- Card Top: Image & Badges -->
              <div class="relative bg-[#101413] p-4 flex items-center justify-center min-h-[220px] overflow-hidden">
                <Image
                  src={imgModule}
                  alt={prod.name}
                  width={400}
                  height={350}
                  loading="lazy"
                  class="w-full h-48 object-contain transform duration-500 group-hover:scale-105"
                />

                <!-- Badges -->
                <div class="absolute top-3 left-3 flex flex-col gap-1 z-10">
                  {prod.badge && (
                    <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                      prod.badge === 'New'
                        ? 'bg-[#5BE584] text-[#050807]'
                        : 'bg-[#2AABEE] text-white'
                    }`}>
                      {prod.badge}
                    </span>
                  )}
                </div>

                <div class="absolute top-3 right-3 z-10">
                  <span class="px-2 py-0.5 rounded-md bg-[#1C201F]/90 text-[10px] font-semibold text-[#9BAAA4] uppercase tracking-wider border border-white/10">
                    {prod.category.replace(/-/g, ' ')}
                  </span>
                </div>
              </div>

              <!-- Card Middle: Specs & Details -->
              <div class="p-5 flex flex-col gap-3 flex-grow justify-between">
                <div>
                  <h2 class="text-base font-bold text-white group-hover:text-[#5BE584] transition-colors leading-snug">
                    {prod.name}
                  </h2>
                  <p class="text-xs text-[#9BAAA4] mt-1.5 line-clamp-2 leading-relaxed">
                    {prod.description}
                  </p>
                </div>

                <!-- Technical Specs Chips -->
                <div class="flex flex-wrap gap-1.5 pt-2 border-t border-white/5">
                  {prod.specs.watt && (
                    <span class="px-2 py-0.5 rounded bg-[#1C201F] text-[10px] font-mono text-[#5BE584] border border-[#5BE584]/20">
                      {prod.specs.watt}
                    </span>
                  )}
                  {prod.specs.ip && (
                    <span class="px-2 py-0.5 rounded bg-[#1C201F] text-[10px] font-mono text-[#C1C8C4] border border-white/10">
                      {prod.specs.ip}
                    </span>
                  )}
                  {prod.specs.color && (
                    <span class="px-2 py-0.5 rounded bg-[#1C201F] text-[10px] text-[#9BAAA4] border border-white/10">
                      {prod.specs.color}
                    </span>
                  )}
                </div>
              </div>

              <!-- Card Bottom: Dual Actions -->
              <div class="p-4 pt-0 grid grid-cols-2 gap-2">
                <button
                  type="button"
                  class="trigger-call-modal w-full py-2 px-2.5 rounded-xl bg-[#5BE584] text-[#050807] font-bold text-xs flex items-center justify-center gap-1.5 hover:bg-[#2FD468] transition-all active:scale-95 shadow"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  <span>Call to Order</span>
                </button>

                <a
                  href={telegramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-2 px-2.5 rounded-xl bg-[#1C201F] border border-[#2AABEE]/40 text-[#2AABEE] hover:bg-[#2AABEE]/10 font-bold text-xs flex items-center justify-center gap-1.5 transition-all active:scale-95"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"/>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                  </svg>
                  <span>Telegram</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- No Products Found Empty State -->
      <div id="no-products-found" class="hidden text-center py-20">
        <div class="w-16 h-16 rounded-full bg-[#1C201F] text-[#9BAAA4] flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white">No Matching Products Found</h3>
        <p class="text-sm text-[#9BAAA4] mt-2 max-w-md mx-auto">
          We have hundreds more fixtures in our Sosa Merkato warehouse. Contact our managers directly to find what you need.
        </p>
        <button
          type="button"
          class="trigger-call-modal mt-6 px-6 py-3 rounded-full bg-[#5BE584] text-[#050807] font-bold text-sm hover:bg-[#2FD468] transition-all"
        >
          Call Showroom Inquiries
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script src="../../scripts/filter.ts"></script>
