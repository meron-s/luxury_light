---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import products from '../../data/products.json';
import categories from '../../data/categories.json';
import site from '../../data/site.json';
import fallbackHero from '../../assets/hero/hero-main.jpg';
import TelegramFeed from '../../components/sections/TelegramFeed.astro';

// Automatically import all product images for Sharp optimization
const productImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/**/*.{jpg,png,jpeg}', { eager: true });

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://luxuryelectricall.com';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Products",
      "item": `${siteUrl}/products`
    }
  ]
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Luxury Electrical & Lighting Catalog",
  "description": "Architectural and commercial electrical fixtures available at Sosa Merkato, Addis Ababa",
  "numberOfItems": products.length,
  "itemListElement": products.slice(0, 12).map((prod, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Product",
      "name": prod.name,
      "description": prod.description,
      "offers": {
        "@type": "Offer",
        "priceCurrency": "ETB",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "Organization",
          "name": "Luxury Electrical & Lighting"
        }
      }
    }
  }))
};
---

<BaseLayout
  title="Electrical & Lighting Products Catalog — Wholesale & Retail Addis Ababa | Luxury Electrical"
  description="Explore our full inventory of LED strip lights, TESLA LED bulbs, KK anti-glare recessed spotlights, street floodlights, STAR designer switches, and certified power cables in Addis Ababa."
  currentPath="/products"
  extraJsonLd={[breadcrumbSchema, itemListSchema]}
>
  <div class="py-12 lg:py-16 bg-white min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Catalog Header -->
      <div class="flex flex-col gap-4 text-center max-w-3xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 justify-center text-xs font-bold text-[#5BE584] uppercase tracking-widest" data-i18n="catalog.badge">
          CATALOG • ARCHITECTURAL & COMMERCIAL SPECIFICATIONS
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#0f172a] tracking-tight" data-i18n="catalog.title">
          Complete Fixtures & Supplies Portfolio
        </h1>
        <p class="text-sm sm:text-base text-gray-500 leading-relaxed" data-i18n="catalog.desc">
          Filter by category or search our inventory. All products can be ordered immediately via phone or Telegram.
        </p>
      </div>

      <!-- Search & Filters Container -->
      <div class="flex flex-col gap-6 mb-10">
        <!-- Search Input -->
        <div class="relative max-w-xl mx-auto w-full">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-[#9BAAA4]">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
          </div>
          <input
            id="product-search-input"
            type="search"
            placeholder="Search fixtures by keyword (e.g., spot, breaker, cable, RGB, 150W)..."
            data-i18n-placeholder="catalog.search_placeholder"
            class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-[#f4f7f6] border border-gray-200 text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#28e374] transition-colors text-sm shadow-inner"
          />
        </div>

        <!-- Category Filter Chips -->
        <div class="flex flex-wrap items-center justify-center gap-2 max-w-4xl mx-auto" role="tablist" aria-label="Category Filters">
          <button
            type="button"
            data-category="all"
            class="filter-chip active px-4 py-2 rounded-xl text-xs font-bold tracking-wider uppercase border transition-all hover:scale-105 active:scale-95"
          >
            All Products ({products.length})
          </button>
          {categories.map((cat) => {
            const catCount = products.filter(p => p.category === cat.slug).length;
            return (
              <button
                type="button"
                data-category={cat.slug}
                class="filter-chip px-4 py-2 rounded-xl text-xs font-bold tracking-wider uppercase border transition-all hover:scale-105 active:scale-95"
              >
                {cat.name} ({catCount})
              </button>
            );
          })}
        </div>

        <!-- Product Count Indicator -->
        <div class="flex justify-between items-center text-xs text-gray-500 border-b border-gray-200 pb-4">
          <span id="product-count">Showing {products.length} of {products.length} products</span>
          <span class="text-[11px] text-[#5BE584]">Wholesale & Retail pricing via direct inquiry</span>
        </div>
      </div>

      <!-- Product Cards Grid -->
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {products.map((prod) => {
          const imgModule = productImages[prod.image]?.default || fallbackHero;
          const telegramPrefill = encodeURIComponent(`Hello, I am interested in ordering: ${prod.name}`);
          const telegramUrl = `${site.telegram.inbox}?text=${telegramPrefill}`;

          return (
            <div
              class="product-card group rounded-2xl sm:rounded-3xl bg-white border border-gray-200 hover:border-[#28e374]/50 shadow-sm transition-all duration-300 flex flex-col justify-between overflow-hidden hover:shadow-2xl hover:-translate-y-1"
              data-category={prod.category}
              data-name={prod.name}
              data-desc={prod.description}
            >
              <!-- Card Top: Edge-to-Edge Image & Floating Badges -->
              <div class="relative w-full aspect-[16/10] bg-gray-50 overflow-hidden">
                <Image
                  src={imgModule}
                  alt={prod.name}
                  width={600}
                  height={375}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />

                <!-- Top-Left Badge -->
                <div class="absolute top-3 left-3 z-10">
                  {prod.badge && (
                    <span class={`px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-black uppercase tracking-wider shadow-sm ${
                      prod.badge === 'New'
                        ? 'bg-[#5BE584] text-[#050807]'
                        : prod.badge === 'Featured'
                          ? 'bg-[#28e374] text-[#050807]'
                          : 'bg-[#2AABEE] text-white'
                    }`}>
                      {prod.badge}
                    </span>
                  )}
                </div>

                <!-- Top-Right Category Badge -->
                <div class="absolute top-3 right-3 z-10">
                  <span class="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-[10px] sm:text-[11px] font-bold uppercase tracking-wider border border-white/20 shadow-sm">
                    {prod.category.replace(/-/g, ' ')}
                  </span>
                </div>
              </div>

              <!-- Card Middle: Product Info -->
              <div class="p-5 flex flex-col gap-3 flex-grow justify-between">
                <div>
                  <!-- Product Name -->
                  <h2 class="text-base sm:text-lg font-bold text-[#0f172a] group-hover:text-[#28e374] transition-colors leading-snug">
                    {prod.name}
                  </h2>
                  <!-- Product Description -->
                  <p class="text-xs sm:text-sm text-gray-500 mt-1.5 line-clamp-2 leading-relaxed">
                    {prod.description}
                  </p>
                </div>

                <!-- Technical Specs Pill Chips with Icons -->
                <div class="flex flex-wrap gap-2 pt-3 border-t border-gray-100">
                  {prod.specs.ip && (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#f4f7f6] border border-gray-200 text-[11px] font-semibold text-gray-600">
                      <svg class="shrink-0 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      </svg>
                      {prod.specs.ip}
                    </span>
                  )}
                  {prod.specs.color && (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#f4f7f6] border border-gray-200 text-[11px] font-semibold text-gray-600">
                      <svg class="shrink-0 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <circle cx="12" cy="12" r="4"/>
                        <line x1="21.17" y1="8" x2="12" y2="8"/>
                        <line x1="3.95" y1="6.06" x2="8.54" y2="14"/>
                        <line x1="10.88" y1="21.94" x2="15.46" y2="14"/>
                      </svg>
                      {prod.specs.color}
                    </span>
                  )}
                  {prod.specs.watt && (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#f4f7f6] border border-gray-200 text-[11px] font-semibold text-gray-600">
                      <svg class="shrink-0 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"/>
                        <line x1="12" y1="1" x2="12" y2="3"/>
                        <line x1="12" y1="21" x2="12" y2="23"/>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                        <line x1="1" y1="12" x2="3" y2="12"/>
                        <line x1="21" y1="12" x2="23" y2="12"/>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                      </svg>
                      {prod.specs.watt}
                    </span>
                  )}
                </div>

                <!-- Confirm Specs Prompt -->
                <div class="flex items-center gap-1.5 text-[11px] text-[#5BE584] font-medium pt-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>Confirm specifications</span>
                </div>
              </div>

              <!-- Card Bottom: Dual Action Buttons -->
              <div class="px-5 pb-5 grid grid-cols-2 gap-2.5">
                <button
                  type="button"
                  data-product-name={prod.name}
                  class="trigger-call-modal w-full py-2.5 px-3 rounded-full bg-[#28e374] text-[#050807] font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 hover:bg-[#2FD468] transition-all active:scale-95 shadow-sm cursor-pointer"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  <span>Call to Order</span>
                </button>

                <a
                  href={telegramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-2.5 px-3 rounded-full bg-[#18201d] border border-gray-700/60 hover:border-[#2aa8e8]/60 hover:bg-[#2aa8e8]/15 text-[#2aa8e8] font-semibold text-xs sm:text-sm flex items-center justify-center gap-1.5 transition-all active:scale-95"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"/>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                  </svg>
                  <span>Telegram</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- No Products Found Empty State -->
      <div id="no-products-found" class="hidden text-center py-20">
        <div class="w-16 h-16 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-[#0f172a]">No Matching Products Found</h3>
        <p class="text-sm text-gray-500 mt-2 max-w-md mx-auto">
          We have hundreds more fixtures in our Sosa Merkato warehouse. Contact our managers directly to find what you need.
        </p>
        <button
          type="button"
          class="trigger-call-modal mt-6 px-6 py-3 rounded-full bg-[#5BE584] text-[#050807] font-bold text-sm hover:bg-[#2FD468] transition-all cursor-pointer"
        >
          Call Showroom Inquiries
        </button>
      </div>
    </div>
  </div>

  <!-- Live Telegram Channel Feed -->
  <TelegramFeed
    title="Daily Stock Arrivals via Telegram"
    subtitle="Direct inventory drops from our Sosa Merkato warehouse to @luxuryelectrical."
    limit={8}
  />
</BaseLayout>

<script src="../../scripts/filter.ts"></script>
