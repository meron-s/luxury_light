---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import TopCategories from '../components/sections/TopCategories.astro';
import FeaturedProducts from '../components/sections/FeaturedProducts.astro';
import TelegramFeed from '../components/sections/TelegramFeed.astro';
import LightingSolutions from '../components/sections/LightingSolutions.astro';
import ShowroomGallery from '../components/sections/ShowroomGallery.astro';
import OrderSteps from '../components/sections/OrderSteps.astro';
import LightingFaq from '../components/sections/LightingFaq.astro';
import AboutTeaser from '../components/sections/AboutTeaser.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import ContactBar from '../components/sections/ContactBar.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where is your showroom located in Addis Ababa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We are located in Merkato, inside the Merkato Sosa Building, conveniently situated between Harere Hotel and Derba Lime and Chemicals on Uganda Street, Addis Ababa. You can inspect working fixtures on our live showroom display wall."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer contractor and wholesale volume discounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, absolutely. We work closely with electrical contractors, interior designers, real estate developers, and retail stores, offering structured wholesale volume pricing. Call our wholesale line at 0910404241 or message us on Telegram."
      }
    },
    {
      "@type": "Question",
      "name": "How fast is delivery within Addis Ababa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We provide prompt same-day dispatch across Addis Ababa for confirmed orders. Alternatively, your order can be packaged and ready for immediate in-person pickup at our Merkato Sosa showroom."
      }
    },
    {
      "@type": "Question",
      "name": "How do I request prices and verify available stock?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can tap any Request Price button on this website, call our direct phone numbers (0911948627, 0935021157, 0910404241, 0910210089), or send your inquiry or Bill of Quantities directly to Telegram (@Rezured)."
      }
    }
  ]
};
---

<BaseLayout
  title="Luxury Electrical & Lighting — Architectural Lighting & Supplies Showroom Addis Ababa"
  description="Addis Ababa's leading supplier of architectural LED strip lights, TESLA LED bulbs, anti-glare KK spotlights, commercial street lighting, STAR designer switches & certified copper cables at Sosa Merkato."
  currentPath="/"
  extraJsonLd={faqSchema}
>
  <!-- Hero Section -->
  <Hero />

  <!-- 1. Expanded Product Category Grid with attractive images and clear navigation -->
  <TopCategories />

  <!-- About Us Teaser Section -->
  <AboutTeaser />

  <!-- 2. Featured Products with product names, available specifications, and Request Price buttons -->
  <FeaturedProducts />

  <!-- Live Feed direct from Telegram channel (@luxuryelectrical) -->
  <TelegramFeed />

  <!-- 3. Lighting Solutions for homes, offices, hotels, commercial spaces, and outdoor areas -->
  <LightingSolutions />

  <!-- 4. Project Gallery and Showroom showcase with a responsive image grid and lightbox -->
  <ShowroomGallery />

  <!-- 5. Simple Three-Step Ordering and Delivery explanation -->
  <OrderSteps />

  <!-- 6. Short Lighting Buying Guides and practical customer FAQs -->
  <LightingFaq />

  <!-- Why Choose Us / We Deliver More Section -->
  <WhyUs />

  <!-- Contact & Order Bar -->
  <ContactBar />
</BaseLayout>
