---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import entranceImg from '../assets/about/showroom-entrance.jpg';
import displayImg from '../assets/about/display-wall.jpg';
import decorativeImg from '../assets/about/decorative-corner.jpg';
---

<BaseLayout
  title={`About Us & Showroom Story // ${site.brand} — Addis Ababa`}
  description={`Discover the heritage, values, and architectural lighting showroom of ${site.name} located at Sosa Merkato, Addis Ababa.`}
  currentPath="/about"
>
  <!-- Hero Section -->
  <section class="py-16 lg:py-24 bg-white border-b border-gray-200 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl flex flex-col gap-5">
        <div class="inline-flex items-center gap-2 text-xs font-bold text-[#5BE584] uppercase tracking-widest">
          <span>ORIGINS & VISION</span>
          <span>•</span>
          <span>MERKATO SOSA BUILDING</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-[#0f172a] tracking-tight leading-tight">
          The Soul of Illumination in Addis Ababa
        </h1>

        <p class="text-lg text-gray-600 leading-relaxed font-light">
          Founded to bridge the gap between world-class photometric engineering and the booming architecture of Ethiopia, {site.name} provides high-performance lighting and electrical systems from the commercial heart of Merkato.
        </p>
      </div>
    </div>
  </section>

  <!-- Story & Vision Grid -->
  <section class="py-16 lg:py-24 bg-[#f9fafb] border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 flex flex-col gap-6">
          <h2 class="text-3xl font-extrabold text-[#0f172a] tracking-tight">
            Curated For Architects, Contractors & Bespoke Homes
          </h2>
          <p class="text-sm text-gray-600 leading-relaxed">
            Light is more than illumination; it shapes how spaces are felt and inhabited. At our Sosa Merkato showroom, we maintain direct relationships with premier manufacturers, importing authentic LED strip spools, optical recessed spotlights, high-lumen streetlights, and STAR luxury switchgear.
          </p>
          <p class="text-sm text-gray-500 leading-relaxed">
            Every fixture in our collection is rigorously evaluated for thermal performance, driver reliability, and color temperature consistency to withstand local grid variations while providing enduring beauty.
          </p>

          <div class="grid grid-cols-2 gap-4 pt-4">
            <div class="p-4 rounded-xl bg-white border border-gray-200">
              <span class="text-2xl font-bold text-[#5BE584] block">4 Showroom Lines</span>
              <span class="text-xs text-gray-500 mt-1 block">Instant direct phone consultation</span>
            </div>
            <div class="p-4 rounded-xl bg-white border border-gray-200">
              <span class="text-2xl font-bold text-[#5BE584] block">6 Core Categories</span>
              <span class="text-xs text-gray-500 mt-1 block">Full architectural electrical scope</span>
            </div>
          </div>
        </div>

        <!-- Right: Photo Gallery of Store -->
        <div class="lg:col-span-6 grid grid-cols-2 gap-4">
          <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-lg">
            <Image
              src={entranceImg}
              alt="Luxury Lighting showroom luminaire display"
              width={600}
              height={700}
              class="w-full h-64 sm:h-80 object-cover hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="space-y-4">
            <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-lg">
              <Image
                src={displayImg}
                alt="Ceiling spotlight fixtures display wall"
                width={600}
                height={400}
                class="w-full h-36 sm:h-44 object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-lg">
              <Image
                src={decorativeImg}
                alt="Amber decorative filament pendant"
                width={600}
                height={400}
                class="w-full h-36 sm:h-44 object-cover hover:scale-105 transition-transform duration-500"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-16 lg:py-24 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold text-[#0f172a] tracking-tight">Our Core Standards</h2>
        <p class="text-sm text-gray-500 mt-2">Principles that govern our sourcing, customer service, and commercial relationships.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-[#f9fafb] border border-gray-200 hover:border-[#28e374]/40 transition-all flex flex-col gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#5BE584]/10 text-[#5BE584] flex items-center justify-center font-bold">01</div>
          <h3 class="text-lg font-bold text-[#0f172a]">Genuine Optical Precision</h3>
          <p class="text-xs text-gray-500 leading-relaxed">
            Strict testing on glare ratings (UGR), true color rendering index (CRI), and clean beam diffusion.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#f9fafb] border border-gray-200 hover:border-[#28e374]/40 transition-all flex flex-col gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#5BE584]/10 text-[#5BE584] flex items-center justify-center font-bold">02</div>
          <h3 class="text-lg font-bold text-[#0f172a]">Transparent Commercial Pricing</h3>
          <p class="text-xs text-gray-500 leading-relaxed">
            Direct pricing advantages in Merkato Sosa Building, providing developers and homeowners exceptional value.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#f9fafb] border border-gray-200 hover:border-[#28e374]/40 transition-all flex flex-col gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#5BE584]/10 text-[#5BE584] flex items-center justify-center font-bold">03</div>
          <h3 class="text-lg font-bold text-[#0f172a]">Dedicated Showroom Team</h3>
          <p class="text-xs text-gray-500 leading-relaxed">
            Four direct manager telephone lines and instant Telegram response for blueprint inquiries and product inquiries.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Location Callout -->
  <section class="py-16 bg-[#f4f7f6]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center gap-6">
      <div class="inline-flex items-center gap-2 text-xs font-bold text-[#5BE584] uppercase tracking-widest">
        <span>VISIT THE SHOWROOM</span>
      </div>
      <h2 class="text-3xl font-extrabold text-[#0f172a]">Experience The Fixtures In Person</h2>
      <p class="text-sm text-gray-600 max-w-xl">
        Visit us at <strong class="text-[#0f172a]">{site.address.line}</strong> in Addis Ababa. Our team is ready to demonstrate live lighting effects, beam spreads, and switch finishes.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/contact"
          class="px-8 py-3.5 rounded-full bg-[#5BE584] text-[#050807] font-bold text-sm hover:bg-[#2FD468] shadow-neon-glow transition-all"
        >
          View Map & Contact Details
        </a>
        <button
          type="button"
          class="trigger-call-modal px-8 py-3.5 rounded-full bg-gray-100 border border-gray-200 text-[#0f172a] font-semibold text-sm hover:border-[#28e374] transition-all"
        >
          Call Our Showroom
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
