# ----------------------------------------------------------------------
# Luxury Lighting — Production Apache / LiteSpeed Configuration
# ----------------------------------------------------------------------

# Directory Index
DirectoryIndex index.html

# Ensure correct MIME types
AddType text/css .css
AddType application/javascript .js
AddType image/webp .webp
AddType image/avif .avif
AddType image/svg+xml .svg
AddType application/json .json

# Force UTF-8 Encoding
AddDefaultCharset UTF-8

# Custom 404 Error Page
ErrorDocument 404 /404.html

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On

  # --------------------------------------------------------------------
  # 1. FORCE HTTPS (MUST BE FIRST BEFORE ANY FILE OR DIRECTORY CHECKS)
  # --------------------------------------------------------------------
  RewriteCond %{HTTPS} !on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{SERVER_PORT} ^80$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --------------------------------------------------------------------
  # 2. LEGACY CATEGORY REDIRECTS
  # --------------------------------------------------------------------
  RewriteRule ^products/fans-and-ventilation/?$ /products/kk-spot-lights [L,R=301]

  # --------------------------------------------------------------------
  # 3. SERVE EXISTING STATIC FILES & DIRECTORIES DIRECTLY
  # --------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # --------------------------------------------------------------------
  # 3. CLEAN URLS (ALLOW /about TO SERVE /about/index.html)
  # --------------------------------------------------------------------
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ /$1.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ /$1/index.html [L]
</IfModule>

# Security Headers (Matching SPEC.md Section 6)
<IfModule mod_headers.c>
  # Enforce strict transport security (HSTS) with subdomains and preload
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"
  
  # Prevent iframe embedding / clickjacking
  Header always set X-Frame-Options "DENY"
  
  # Protect referrer data
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Disable unnecessary browser sensors
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Cross-Origin Opener Policy
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Automatically upgrade any insecure requests to HTTPS
  Header always set Content-Security-Policy "upgrade-insecure-requests; default-src 'self'; img-src 'self' data: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.telesco.pe https://*.telegram.org; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
</IfModule>

# Browser Caching Rules
<IfModule mod_expires.c>
  ExpiresActive On

  # Astro compiled hashed assets (cache forever 1 year)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # HTML & JSON (revalidate)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
